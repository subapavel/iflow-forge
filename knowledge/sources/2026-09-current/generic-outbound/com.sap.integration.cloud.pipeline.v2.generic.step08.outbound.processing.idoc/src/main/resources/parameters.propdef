<?xml version="1.0" encoding="UTF-8" standalone="no"?><parameters><parameter>
    <key/>
    <name>ProcessDirect_Address</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain address of ProcessDirect adapter.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>IDoc_Address</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain IDoc endpoint of the receiving system, e.g., https://&lt;host name&gt;:&lt;port&gt;/sap/bc/idoc_xml?sap-client=&lt;client&gt; </description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>LocationID</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain Cloud Connector location ID in case of proxy type On-Premise.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>IDoc_AuthenticationType</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain authentication type: None | Basic | ClientCertificate | PrincipalPropagation.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>IDoc_ProxyType</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain proxy type: On-Premise | Internet.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>IDoc_ContentType</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain IDoc content type: Application/x-sap.idoc | Text/XML.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>IDoc_PrivateKeyAlias</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain private key alias in case of Client Certificate authentication.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>IDoc_CredentialName</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain credential alias in case of Basic authentication.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>Default_SNDPRN</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain sender partner name, e.g., &lt;SID&gt;CLNT&lt;Client&gt;.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>Default_SNDPRT</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain sender partner type, e.g., LS, LI, KU.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>Default_SNDPOR</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain sender port.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>Default_RCVPRN</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain receiver partner number, e.g., &lt;SID&gt;CLNT&lt;Client&gt;.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>Default_RCVPRT</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain receiver partner type, e.g., LS, LI, KU.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>Default_RCVPOR</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain receiver port.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>Exception_LoggingConfiguration</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Maintain log level to create MPL Attachments in case of processing errors. Possible values: AuditLog,Payload,Property,Header,Exception</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>IDoc_Timeout</name>
    <type>xsd:integer</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description/>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>IDoc_KeepAlive</name>
    <type>xsd:boolean</type>
    <isRequired>false</isRequired>

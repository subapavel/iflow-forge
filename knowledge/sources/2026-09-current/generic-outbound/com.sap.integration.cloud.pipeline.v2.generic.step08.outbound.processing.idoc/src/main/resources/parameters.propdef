  </parameter><parameter>
    <key/>
    <name>Default_EDIDC_List_Names</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Specify the names of the control record fields for which default values may need to be assigned. The field names must be provided as a comma-separated string, e.g., SNDPFC,RCVPFC.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>Default_EDIDC_List_Values</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Specify the default values to be assigned to the corresponding control record fields. The values must be provided as a comma-separated string matching the order of the field names, e.g., LF,AG.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>pidParameterReadSuffixPattern</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>If SAP_ReceiverInterface header is not supplied, this pattern will be used to read control record related String Parameters from Partner Directory.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>AllowedHeadersList</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Enhance allowed header list to your needs.</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
